{
  "name": "papertrail-reader",
  "version": "1.10.0",
  "private": true,
  "description": "Local-first Chrome paper annotations with recoverable anchors",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "bridge:setup": "node bridge/setup.mjs --install",
    "bridge:doctor": "node bridge/doctor.mjs",
    "test:bridge": "node tests/bridge-browser.mjs",
    "test:bilingual": "node tests/bilingual-browser.cjs",
    "test:tasks": "node tests/tasks-browser.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  }
}
