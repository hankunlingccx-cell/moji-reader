{
  "manifest_version": 3,
  "name": "墨迹 · 论文阅读标注",
  "version": "1.10.1",
  "description": "高亮、下划线、加粗与笔记；本地保存、版本记录、备份和重新定位。",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "墨迹 · 打开标注侧栏",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "library.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["anchor.js", "bilingual.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "palette.js",
        "positioning.js",
        "ai-anchors.js",
        "article.js",
        "runtime-errors.js",
        "info.js",
        "task-panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:*;"
  }
}
